# ==============================
# Enterprise AI Chatbot — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` to version control.
# ==============================

# Project / API
PROJECT_NAME=Enterprise AI Chatbot
API_V1_STR=/api/v1

# Security — CHANGE THIS IN PRODUCTION to a long random string!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite (default) or PostgreSQL
# Example PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/chatbot
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# File storage
UPLOAD_DIR=./uploads
VECTOR_DB_DIR=./vector_db

# OpenAI
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

